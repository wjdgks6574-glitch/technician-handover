package main

import (
	_ "embed"
	"encoding/json"
	"fmt"
	"log"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"sync"
	"syscall"
	"time"
	"unsafe"

	webview "github.com/jchv/go-webview2"
)

//go:embed initial_data_v142.json
var initialDataJSON []byte

type Record struct {
	ID       int    `json:"id"`
	Date     string `json:"date"`
	Equip    string `json:"equip"`
	Worker   string `json:"worker"`
	Shift    string `json:"shift,omitempty"`
	Category string `json:"category"`
	Content  string `json:"content"`
	Dong     string `json:"dong"`
	Flag     bool   `json:"flag,omitempty"`
}

var dataFile string    // 네트워크 주 저장소 경로
var cacheFile string   // 로컬 안전망 (네트워크 접근 실패 시에만 사용)
var records []Record
var w webview.WebView
var networkOK bool
var lastNetErr string

// recMu는 records 슬라이스 접근을 보호한다. 저장이 이제 백그라운드 goroutine에서
// 일어나므로 UI 스레드(바인딩)와 저장 goroutine이 동시에 records를 만질 수 있다.
var recMu sync.Mutex

// saveSignal은 "저장할 변경이 생겼다"는 신호다. 버퍼가 1이라 저장이 진행 중일 때
// 들어온 여러 신호는 하나로 합쳐진다(coalesce). 플래그를 빠르게 여러 번 눌러도
// 네트워크 쓰기가 매번 일어나지 않고 마지막 상태만 반영된다.
var saveSignal = make(chan struct{}, 1)

func getDataDir() string {
	appData := os.Getenv("APPDATA")
	if appData == "" {
		home, _ := os.UserHomeDir()
		appData = home
	}
	dir := filepath.Join(appData, "인수인계관리")
	os.MkdirAll(dir, 0755)
	return dir
}

func getNetworkDir() string {
	return `\\172.23.11.175\ETC_JC_BergerHalm\인수인계관리_DB`
}

// readWithTimeout은 파일 읽기가 오래 걸릴 때(예: 네트워크 서버 다운으로
// 인한 SMB 타임아웃) 프로그램이 멈추지 않도록 지정된 시간(초) 안에
// 끝나지 않으면 포기하고 nil을 반환한다.
func readWithTimeout(path string, seconds int) []Record {
	type result struct{ rs []Record }
	ch := make(chan result, 1)
	go func() {
		data, err := os.ReadFile(path)
		if err != nil {
			lastNetErr = "읽기 실패: " + err.Error()
			ch <- result{nil}
			return
		}
		var rs []Record
		if err := json.Unmarshal(data, &rs); err != nil {
			lastNetErr = "데이터 형식 오류: " + err.Error()
			ch <- result{nil}
			return
		}
		lastNetErr = ""
		ch <- result{rs}
	}()
	select {
	case r := <-ch:
		return r.rs
	case <-time.After(time.Duration(seconds) * time.Second):
		lastNetErr = fmt.Sprintf("응답 없음 (%d초 초과) - 서버가 꺼져있거나 경로에 접근할 수 없습니다", seconds)
		return nil
	}
}

// writeWithTimeout은 네트워크 쓰기가 오래 걸릴 때 프로그램이 멈추지
// 않도록 지정된 시간(초) 안에 끝나지 않으면 실패로 처리한다.
func writeWithTimeout(path string, rs []Record, seconds int) bool {
	ch := make(chan bool, 1)
	go func() {
		data, err := json.MarshalIndent(rs, "", "  ")
		if err != nil {
			lastNetErr = "직렬화 오류: " + err.Error()
			ch <- false
			return
		}
		dir := filepath.Dir(path)
		if err := os.MkdirAll(dir, 0755); err != nil {
			lastNetErr = "폴더 생성 실패: " + err.Error()
			ch <- false
			return
		}
		// 임시파일 이름에 나노초를 붙여 유니크하게 만든다. JC01/JC02 두 PC가
		// 같은 폴더에 동시에 쓸 때 같은 .tmp를 덮어써 깨지는 것을 막기 위함
		// (rename은 원자적이라 최종 파일은 둘 중 하나로 온전히 남는다).
		tmp := fmt.Sprintf("%s.%d.tmp", path, time.Now().UnixNano())
		if err := os.WriteFile(tmp, data, 0644); err != nil {
			lastNetErr = "파일 쓰기 실패: " + err.Error()
			ch <- false
			return
		}
		if err := os.Rename(tmp, path); err != nil {
			os.Remove(tmp)
			lastNetErr = "파일 이름변경 실패: " + err.Error()
			ch <- false
			return
		}
		lastNetErr = ""
		ch <- true
	}()
	select {
	case ok := <-ch:
		return ok
	case <-time.After(time.Duration(seconds) * time.Second):
		lastNetErr = fmt.Sprintf("응답 없음 (%d초 초과) - 서버가 꺼져있거나 경로에 접근할 수 없습니다", seconds)
		return false
	}
}

// migrateEquipNames는 예전에 "ATW#XX"로 저장되던 설비명을
// "#XX"로 통일한다 (ATW#61은 예외로 그대로 유지).
// 기존에 저장된 네트워크/로컬 파일의 데이터도 이 규칙으로 정리한다.
var equipRenameMap = map[string]string{
	"ATW#21": "#21",
	"ATW#22": "#22",
	"ATW#31": "#31",
	"ATW#32": "#32",
	"ATW#41": "#41",
	"ATW#42": "#42",
	"ATW#51": "#51",
	"ATW#52": "#52",
}

func migrateEquipNames(rs []Record) ([]Record, bool) {
	changed := false
	for i := range rs {
		if newName, ok := equipRenameMap[rs[i].Equip]; ok {
			rs[i].Equip = newName
			changed = true
		}
	}
	return rs, changed
}

// migrateIDOffsets는 JC01/JC02가 같은 records.json을 공유하면서 오프라인 중
// 각자 로컬 백업 기준으로 ID를 새로 채번하다가 재접속 시 충돌하는 문제를
// 막기 위해, 동(dong)별로 ID 대역을 분리한다.
// JC01: 100000번대, JC02: 200000번대. 예전 방식(순차 정수 ID)으로 저장된
// 데이터를 만나면 여기서 한 번만 옮겨준다 (이미 대역 안에 있으면 그대로 둠).
func migrateIDOffsets(rs []Record) ([]Record, bool) {
	changed := false
	for i := range rs {
		switch rs[i].Dong {
		case "JC01":
			if rs[i].ID < 100000 {
				rs[i].ID += 100000
				changed = true
			}
		case "JC02":
			if rs[i].ID < 200000 {
				rs[i].ID += 200000
				changed = true
			}
		}
	}
	return rs, changed
}

func loadRecords() {
	dataFile = filepath.Join(getNetworkDir(), "records.json")
	cacheFile = filepath.Join(getDataDir(), "records_local_backup.json")

	// 1순위: 네트워크 파일 (5초 타임아웃)
	netRecords := readWithTimeout(dataFile, 5)
	if netRecords != nil {
		records = netRecords
		networkOK = true
		eqRecords, eqChanged := migrateEquipNames(records)
		idRecords, idChanged := migrateIDOffsets(eqRecords)
		records = idRecords
		if eqChanged || idChanged {
			saveRecords()
			return
		}
		// 로컬에 안전망 백업 (네트워크 다운 시 대비)
		writeWithTimeout(cacheFile, records, 3)
		return
	}
	networkOK = false

	// 2순위: 네트워크 접근 실패 시 → 로컬 백업본
	localRecords := readWithTimeout(cacheFile, 3)
	if localRecords != nil {
		records = localRecords
		eqRecords, eqChanged := migrateEquipNames(records)
		idRecords, idChanged := migrateIDOffsets(eqRecords)
		records = idRecords
		if eqChanged || idChanged {
			writeWithTimeout(cacheFile, records, 3)
		}
		return
	}

	// 3순위: 로컬 백업도 없으면 → 프로그램 내장 초기 데이터
	var initial []Record
	if jerr := json.Unmarshal(initialDataJSON, &initial); jerr == nil {
		records = initial
	} else {
		records = []Record{}
	}
}

func saveRecords() {
	ok := writeWithTimeout(dataFile, records, 5)
	networkOK = ok
	// 네트워크 저장 성공 여부와 관계없이 로컬 안전망은 항상 갱신
	writeWithTimeout(cacheFile, records, 3)
}

// requestSave는 변경이 생겼음을 백그라운드 저장 goroutine에 알린다. UI 스레드는
// 이 함수 호출 후 곧바로 반환하므로 네트워크 왕복 동안 창이 멈추지 않는다.
// saveSignal 버퍼가 1이라 저장 진행 중 들어온 신호들은 하나로 합쳐진다.
func requestSave() {
	select {
	case saveSignal <- struct{}{}:
	default: // 이미 저장 대기 중 - 합침
	}
}

// startFlusher는 저장 신호를 받아 flushOnce를 "한 번에 하나씩" 실행하는 백그라운드
// goroutine을 띄운다. 직렬 실행이라 저장끼리 겹쳐 상대 동 데이터가 유실되는 일이
// 없다. loadRecords 뒤, UI 시작 전에 한 번 호출한다.
func startFlusher() {
	go func() {
		for range saveSignal {
			flushOnce()
		}
	}()
}

// flushOnce는 현재 메모리 상태를 네트워크(및 로컬 백업)에 저장한다. 원칙:
//   - 내 동(myDong) 레코드는 이 프로그램만 쓰므로 "메모리"가 정본이다.
//   - 상대 동 레코드는 이 프로그램이 절대 안 쓰므로 "네트워크"가 정본이다.
// 저장 직전 네트워크를 다시 읽어 상대 동 최신본을 가져오고, 내 동은 메모리 것으로
// 통째 교체해 합친다. (예전 saveMerged의 델타 병합과 결과는 같으나, 변경이 여러
// 개 쌓여도 항상 올바르고 겹침에 안전하다.) 느린 네트워크 IO는 lock을 잡지 않은
// 채로 하고 records 교체만 lock 안에서 하므로 UI를 오래 막지 않는다.
func flushOnce() {
	base := readWithTimeout(dataFile, 5)
	haveBase := base != nil
	if haveBase {
		base, _ = migrateEquipNames(base)
		base, _ = migrateIDOffsets(base)
	}

	recMu.Lock()
	merged := make([]Record, 0, len(records))
	for _, r := range records { // 내 동: 메모리(정본)
		if r.Dong == myDong {
			merged = append(merged, r)
		}
	}
	if haveBase { // 상대 동: 네트워크 최신본
		for _, r := range base {
			if r.Dong != myDong {
				merged = append(merged, r)
			}
		}
	} else { // 네트워크를 못 읽었으면 상대 동도 기존 메모리 유지(안전 우선)
		for _, r := range records {
			if r.Dong != myDong {
				merged = append(merged, r)
			}
		}
	}
	records = merged
	out := make([]Record, len(records))
	copy(out, records)
	recMu.Unlock()

	networkOK = writeWithTimeout(dataFile, out, 5)
	// 네트워크 저장 성공 여부와 관계없이 로컬 안전망은 항상 갱신
	writeWithTimeout(cacheFile, out, 3)
}

// JC01은 100000번대 ID를 쓴다 (JC02는 200000번대). 공유 파일을 오프라인
// 상태에서 각자 채번하다가 재접속했을 때 ID가 겹치지 않게 하기 위함.
func nextID(rs []Record) int {
	max := 100000
	for _, r := range rs {
		if r.ID > max && r.ID < 200000 {
			max = r.ID
		}
	}
	return max + 1
}

func toJSON(v interface{}) string {
	b, _ := json.Marshal(v)
	return string(b)
}

// myDong은 이 빌드가 쓰기 권한을 갖는 동이다. dbAdd/dbUpdate/dbDelete/
// dbSetFlag는 records.json을 JC01/JC02가 공유하는 상황에서 상대 동
// 데이터를 실수로(또는 의도적으로) 건드리는 것을 막는다. 소유권 검사는 각
// 바인딩의 lock 안 루프에서 Dong==myDong으로 하므로(상대 동이면 매칭 안 됨)
// UI를 우회해도 거부된다. 읽기(dbGetAll)는 항상 양쪽 동 전체를 그대로 준다.
const myDong = "JC01"

func handleBind(w webview.WebView) {
	w.Bind("dbGetAll", func() string {
		status := "네트워크 저장소 연결됨"
		if !networkOK {
			status = "⚠ 네트워크 연결 안됨 - 로컬 백업본 사용 중"
		}
		recMu.Lock()
		snapshot := make([]Record, len(records))
		copy(snapshot, records)
		recMu.Unlock()
		return toJSON(map[string]interface{}{
			"records": snapshot,
			"network": dataFile,
			"backup":  cacheFile,
			"status":  status,
			"error":   lastNetErr,
		})
	})

	// 아래 4개(추가/수정/삭제/플래그)는 예전엔 saveMerged로 네트워크를 다시 읽고
	// 쓰는 저장까지 UI 스레드에서 동기로 했다. 데이터가 1만 건대로 커지자 그
	// 네트워크 왕복 동안 창 전체가 멈추는 렉이 생겼다. 이제는 메모리(records)만
	// 즉시 바꾸고 바로 반환한 뒤, 실제 저장은 requestSave로 백그라운드에 맡긴다.
	// 소유권 검사(Dong==myDong)는 lock 안 루프에서 하므로 상대 동 레코드는 여전히
	// 거부된다(서버 최종 방어, 이제 변경과 원자적).
	w.Bind("dbAdd", func(date, equip, worker, shift, category, content, dong string) string {
		recMu.Lock()
		added := Record{
			ID:       nextID(records),
			Date:     strings.TrimSpace(date),
			Equip:    strings.TrimSpace(equip),
			Worker:   strings.TrimSpace(worker),
			Shift:    strings.TrimSpace(shift),
			Category: strings.TrimSpace(category),
			Content:  strings.TrimSpace(content),
			Dong:     myDong, // 클라이언트가 보낸 dong은 무시 - 항상 내 동으로 생성
		}
		records = append(records, added)
		recMu.Unlock()
		requestSave()
		return toJSON(added)
	})

	w.Bind("dbUpdate", func(id int, date, equip, worker, shift, category, content, dong string) bool {
		recMu.Lock()
		found := false
		for i := range records {
			if records[i].ID == id && records[i].Dong == myDong {
				records[i].Date = strings.TrimSpace(date)
				records[i].Equip = strings.TrimSpace(equip)
				records[i].Worker = strings.TrimSpace(worker)
				records[i].Shift = strings.TrimSpace(shift)
				records[i].Category = strings.TrimSpace(category)
				records[i].Content = strings.TrimSpace(content)
				// Dong은 내 동으로 고정 - 레코드를 다른 동으로 옮기는 것도 금지
				found = true
				break
			}
		}
		recMu.Unlock()
		if found {
			requestSave()
		}
		return found
	})

	w.Bind("dbDelete", func(id int) bool {
		recMu.Lock()
		found := false
		out := make([]Record, 0, len(records))
		for _, r := range records {
			if r.ID == id && r.Dong == myDong {
				found = true
				continue
			}
			out = append(out, r)
		}
		if found {
			records = out
		}
		recMu.Unlock()
		if found {
			requestSave()
		}
		return found
	})

	w.Bind("dbSetFlag", func(id int, flag bool) bool {
		recMu.Lock()
		found := false
		for i := range records {
			if records[i].ID == id && records[i].Dong == myDong {
				records[i].Flag = flag
				found = true
				break
			}
		}
		recMu.Unlock()
		if found {
			requestSave()
		}
		return found
	})

	w.Bind("dbGetPath", func() string {
		status := "네트워크 저장소 연결됨"
		if !networkOK {
			status = "⚠ 네트워크 연결 안됨 - 로컬 백업본 사용 중"
		}
		return toJSON(map[string]string{
			"network": dataFile,
			"backup":  cacheFile,
			"status":  status,
			"error":   lastNetErr,
		})
	})

	w.Bind("openPartsFile_go", func() string {
		return openPartsFileImpl()
	})

	// 메모 저장은 localStorage를 쓰면 SetHtml(NavigateToString)의 opaque
	// origin 때문에 재시작 시 사라진다. 그래서 로컬 파일에 저장한다. key로
	// 파일명을 분리(JC01=hk_memo / JC02=hk_memo_jc02)해 같은 PC에 두 exe를
	// 깔아도 메모가 안 섞이게 한다. 파일은 %APPDATA%\인수인계관리\<key>.txt.
	w.Bind("memoSave", func(key, text string) bool {
		p := filepath.Join(getDataDir(), filepath.Base(key)+".txt")
		return os.WriteFile(p, []byte(text), 0644) == nil
	})
	w.Bind("memoLoad", func(key string) string {
		data, err := os.ReadFile(filepath.Join(getDataDir(), filepath.Base(key)+".txt"))
		if err != nil {
			return ""
		}
		return string(data)
	})
}

func openPartsFileImpl() string {
	dir := `\\172.23.11.175\ETC_JC_BergerHalm\1동\Pending Item&지속관리`
	entries, err := os.ReadDir(dir)
	if err != nil {
		return "ERR:폴더를 찾을 수 없습니다 (" + err.Error() + ")"
	}
	var target string
	for _, e := range entries {
		name := e.Name()
		if strings.HasPrefix(name, "~$") {
			continue
		}
		if strings.Contains(name, "JC_1 Sorter 필요 Parts") &&
			(strings.HasSuffix(name, ".xlsx") || strings.HasSuffix(name, ".xls") || strings.HasSuffix(name, ".xlsb")) {
			target = filepath.Join(dir, name)
			break
		}
	}
	if target == "" {
		return "ERR:파일을 찾을 수 없습니다"
	}
	cmd := exec.Command("cmd", "/C", "start", "", target)
	if err := cmd.Start(); err != nil {
		return "ERR:파일 열기 실패 (" + err.Error() + ")"
	}
	return "OK:" + target
}

const (
	SW_MAXIMIZE = 3
)

func maximizeWindow(hwnd unsafe.Pointer) {
	user32 := syscall.NewLazyDLL("user32.dll")
	showWindow := user32.NewProc("ShowWindow")
	showWindow.Call(uintptr(hwnd), uintptr(SW_MAXIMIZE))
}

func main() {
	loadRecords()
	startFlusher() // 백그라운드 저장 goroutine 시작 (loadRecords 뒤, UI 앞)

	w = webview.NewWithOptions(webview.WebViewOptions{
		Debug: false,
		// 버전과 무관한 고정 데이터 폴더. 지정하지 않으면 WebView2가
		// %AppData%\<exe 파일명>을 쓰는데, 버전 올릴 때 exe 파일명이
		// 바뀌면 메모(localStorage)가 딴 폴더로 새로 시작돼 사라진 것처럼
		// 보인다. 여기 고정해서 버전이 바뀌어도 메모가 유지되게 한다.
		DataPath: filepath.Join(getDataDir(), "webview2"),
		WindowOptions: webview.WindowOptions{
			Title:  "인수인계 관리",
			Width:  1280,
			Height: 800,
			Center: true,
		},
	})
	if w == nil {
		log.Fatal("WebView2 초기화 실패. Windows 10/11이 필요합니다.")
	}
	defer w.Destroy()

	w.SetTitle("📋 인수인계 관리")

	go func() {
		time.Sleep(300 * time.Millisecond)
		maximizeWindow(w.Window())
	}()

	handleBind(w)
	w.SetHtml(buildHTML())
	w.Run()

	// 창이 닫힐 때, 백그라운드에 아직 반영 안 된 변경이 남아있을 수 있으니
	// 마지막으로 한 번 동기 저장하고 종료한다 (막 누른 플래그/추가/수정이
	// 유실되지 않도록).
	flushOnce()
}

var _ = unsafe.Pointer(nil)

func buildHTML() string {
	return fmt.Sprintf(`<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>인수인계 관리</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'맑은 고딕',sans-serif;background:#f0f4f8;color:#1a202c;font-size:13px;height:100vh;display:flex;flex-direction:column;overflow:hidden}
.topbar{background:#1e3a5f;color:#fff;display:flex;align-items:center;padding:0 16px;height:50px;flex-shrink:0;gap:10px}
.topbar h1{font-size:15px;font-weight:600}
.badge{font-size:11px;color:#90cdf4;background:rgba(255,255,255,0.15);padding:2px 10px;border-radius:99px}
.spacer{flex:1}
.btn{padding:5px 14px;border:none;border-radius:6px;cursor:pointer;font-size:12px;font-family:'맑은 고딕',sans-serif;font-weight:600}
.btn-new{background:#3b82f6;color:#fff}.btn-new:hover{background:#2563eb}
.btn-csv{background:#059669;color:#fff;margin-left:4px}.btn-csv:hover{background:#047857}
.btn-parts{background:#7c3aed;color:#fff;padding:5px 12px;border:none;border-radius:6px;cursor:pointer;font-size:12px;font-family:'맑은 고딕',sans-serif;font-weight:600;white-space:nowrap}.btn-parts:hover{background:#6d28d9}
.main{display:flex;flex:1;overflow:hidden;gap:8px;padding:8px}
.left{display:flex;flex-direction:column;flex:1;background:#fff;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0}
.searchbar{padding:10px 12px;border-bottom:1px solid #e2e8f0;display:flex;gap:8px;align-items:center;background:#f8fafc}
.sw{position:relative}
.sw input{width:160px;padding:6px 10px;border:1px solid #cbd5e0;border-radius:6px;font-size:12px;font-family:'맑은 고딕',sans-serif;background:#fff}
select{padding:6px 8px;border:1px solid #cbd5e0;border-radius:6px;font-size:12px;font-family:'맑은 고딕',sans-serif;background:#fff;cursor:pointer}
.ms-wrap{position:relative}
.ms-trigger{padding:6px 10px;border:1px solid #cbd5e0;border-radius:6px;font-size:12px;font-family:'맑은 고딕',sans-serif;background:#fff;cursor:pointer;white-space:nowrap;min-width:90px;text-align:left}
.ms-trigger.active{border-color:#3b82f6;background:#eff6ff;color:#1d4ed8}
.ms-panel{display:none;position:absolute;top:calc(100% + 4px);left:0;background:#fff;border:1px solid #cbd5e0;border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.12);z-index:50;min-width:180px;max-height:320px;overflow-y:auto;padding:6px}
.ms-panel.open{display:block}
.ms-item{display:flex;align-items:center;gap:7px;padding:6px 8px;border-radius:5px;cursor:pointer;font-size:12px}
.ms-item:hover{background:#f0f4f8}
.ms-item input{cursor:pointer}
.ms-footer{display:flex;gap:6px;padding:6px 4px 2px;border-top:1px solid #f0f4f8;margin-top:4px}
.ms-footer button{flex:1;padding:5px;border:1px solid #cbd5e0;border-radius:5px;background:#fff;font-size:11px;cursor:pointer;font-family:'맑은 고딕',sans-serif}
.ms-footer button:hover{background:#f0f4f8}
.cntbar{padding:4px 12px;font-size:11px;color:#718096;border-bottom:1px solid #f0f4f8;background:#f8fafc}
.tw{flex:1;overflow-y:auto;overflow-x:hidden}
.fhead{display:flex;background:#edf2f7;border-bottom:2px solid #cbd5e0;position:sticky;top:0;z-index:1}
.fhead .fc{padding:8px 10px;text-align:center;font-size:12px;font-weight:600;color:#2d3748}
.th-l{text-align:left!important}
.frow{display:flex;border-bottom:1px solid #f0f4f8;cursor:pointer;transition:background .1s}
.frow:hover{background:#ebf8ff}
.frow.sel{background:#bee3f8}
.fc{padding:8px 10px;font-size:12px;display:flex;align-items:center;justify-content:center;min-width:0}
.fc-flag{flex:0 0 30px;width:30px;padding:0}
.flagbtn{background:none;border:none;cursor:pointer;font-size:14px;color:#cbd5e0;padding:2px 4px;line-height:1;border-radius:4px}
.flagbtn:hover{background:#edf2f7}
.flagbtn.on{color:#e53e3e}
.flagbtn.dim{color:#e2e8f0;cursor:default}
.frow.shift-day{background:#fef9c3}
.frow.shift-night{background:#dbeafe}
.frow.foreign{background:#fafbfc}
.frow.flagged{box-shadow:inset 3px 0 0 #e53e3e}
.fc-dong{flex:0 0 44px;width:44px;padding-left:3px;padding-right:3px}
.dong-badge{font-size:10px;color:#2d4a7a;background:#e8edf4;padding:2px 5px;border-radius:4px;font-weight:600}
.fc-d{flex:0 0 58px;width:58px;color:#4a5568;white-space:nowrap;padding-left:4px;padding-right:4px}
.fc-e{flex:0 0 56px;width:56px;padding-left:3px;padding-right:3px}
.fc-w{flex:0 0 68px;width:68px;color:#4a5568;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-left:4px;padding-right:4px}
.fc-w .wk{width:100%;line-height:1.2;text-align:center}
.wk-shift{font-size:9px;font-weight:700;color:#2b6cb0;margin-bottom:1px}
.fc-c{flex:0 0 96px;width:96px}
.fc-ct{flex:1 1 auto;min-width:0;justify-content:flex-start;align-items:flex-start}
.fc-ct .pv{white-space:pre-wrap;max-height:146px;overflow:hidden;line-height:1.5;word-break:break-all;width:100%}
.chip{display:inline-block;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600}
.c설비이슈{background:#bee3f8;color:#2b6cb0}
.c전달사항{background:#fefcbf;color:#744210}
.c기자재관리{background:#c6f6d5;color:#276749}
.cClassification{background:#fed7aa;color:#7b341e}
.c감소활동{background:#e9d8fd;color:#553c9a}
.eb{display:inline-block;padding:2px 5px;border-radius:4px;font-size:11px;font-weight:600}
.right{display:flex;flex-direction:column;width:270px;flex-shrink:0;gap:8px}
.memo-card{flex:1;min-height:260px;background:#fffaf0;border:1px solid #f6ad55;border-radius:10px;display:flex;flex-direction:column;overflow:hidden}
.memo-hdr{background:#dd7c1e;color:#fff;padding:8px 12px;font-size:12px;font-weight:600}
#memo-text{flex:1;width:100%;border:none;background:transparent;resize:none;padding:12px;font-family:'맑은 고딕',sans-serif;font-size:12px;line-height:1.6;outline:none;color:#5a4a3a}
.memo-footer{padding:4px 12px 8px;font-size:10px;color:#c08a4a;text-align:right}
.pm-col{display:flex;flex-direction:column;flex:0 0 auto;background:#fff;border:1px solid #e2e8f0;border-radius:10px;overflow:hidden}
.pm-hdr{background:#1e3a5f;color:#fff;padding:8px 12px;font-size:12px;font-weight:600;display:flex;align-items:center;gap:8px;flex-shrink:0}
.pm-saved{font-size:10px;font-weight:400;color:#bee3f8;margin-left:auto}
.pm-grid{flex:1;overflow-y:auto;display:flex;align-items:flex-start;gap:1px;background:#e2e8f0;padding:1px}
.pm-half{flex:1;min-width:0;display:grid;grid-template-columns:max-content 210px;align-content:start;gap:1px;background:#e2e8f0}
.pm-cell{background:#fff;font-size:12px;padding:6px 8px;line-height:1.5;min-height:34px;overflow-wrap:anywhere;white-space:pre-wrap}
.pm-cell.pm-h{background:#1e3a5f;color:#fff;font-weight:600;text-align:center;position:sticky;top:0;z-index:1;min-height:0;padding:5px}
.pm-cell.pm-name{background:#2c7a7b;color:#fff;font-weight:700;text-align:center;white-space:nowrap;padding:4px 7px;display:flex;align-items:center;justify-content:center}
.pm-cell.pm-text{cursor:text;color:#2a4365;font-size:10px}
.pm-cell.pm-text:focus{outline:2px solid #63b3ed;outline-offset:-2px;background:#f7fbff}
.pm-cell.pm-empty{background:#f7fafc}
.card{background:#fff;border-radius:10px;border:1px solid #e2e8f0;overflow:hidden}
.cal-nav{background:#1e3a5f;color:#fff;display:flex;align-items:center;padding:6px 10px}
.cal-nav button{background:none;border:1px solid rgba(255,255,255,.3);color:#fff;border-radius:4px;width:24px;height:24px;cursor:pointer;font-size:12px}
.cal-nav button:hover{background:rgba(255,255,255,.15)}
.cal-nav span{flex:1;text-align:center;font-size:13px;font-weight:600}
.dow{display:grid;grid-template-columns:repeat(7,1fr);padding:4px 6px 0;gap:2px}
.dow span{text-align:center;font-size:10px;color:#718096;padding:2px 0}
.days{display:grid;grid-template-columns:repeat(7,1fr);padding:2px 6px 8px;gap:2px}
.day{text-align:center;padding:3px 0;font-size:12px;border-radius:5px;cursor:pointer;color:#4a5568;position:relative;user-select:none}
.day:hover{background:#ebf8ff}
.day.hd{font-weight:700;color:#2b6cb0}
.day.hd::after{content:'';position:absolute;bottom:1px;left:50%;transform:translateX(-50%);width:4px;height:4px;border-radius:50%;background:#3b82f6}
.day.sat{color:#2563eb}
.day.sun{color:#e53e3e}
.day.rng{background:#c6f6d5;color:#22543d}
.day.td2{background:#3b82f6;color:#fff;font-weight:700}.day.td2::after{background:#fff}
.day.sd{background:#f6e05e;color:#744210}.day.sd::after{background:#744210}
.day.em{cursor:default}.day.em:hover{background:none}
.cal-range{display:flex;align-items:center;gap:4px;padding:6px 10px;border-top:1px solid #edf2f7;font-size:11px;color:#4a5568}
.cal-range .rin{flex:1;min-width:0;display:flex;align-items:center;border:1px solid #cbd5e0;border-radius:4px;overflow:hidden;background:#fff}
.cal-range .rin input[type=text]{flex:1;min-width:0;font-size:11px;padding:2px 4px;border:none;outline:none;background:none}
.cal-range .rpick{flex:0 0 18px;width:18px;padding:0;border:none;background:none;cursor:pointer;color:transparent}
.cal-range .rpick::-webkit-datetime-edit,.cal-range .rpick::-webkit-inner-spin-button,.cal-range .rpick::-webkit-clear-button{display:none}
.cal-range .rpick::-webkit-calendar-picker-indicator{margin:0;padding:0;cursor:pointer;opacity:.6}
.cal-range button{background:#e2e8f0;border:none;border-radius:4px;padding:3px 7px;font-size:10px;cursor:pointer;color:#4a5568}
.cal-range button:hover{background:#cbd5e0}
.cal-hint{padding:6px 10px;font-size:10px;color:#a0aec0;text-align:center;border-top:1px solid #edf2f7}
.mbg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:100;align-items:center;justify-content:center}
.mbg.open{display:flex}
.modal{background:#fff;border-radius:12px;padding:22px;width:500px;max-width:95vw;box-shadow:0 20px 60px rgba(0,0,0,.3)}
.modal h2{font-size:15px;font-weight:600;margin-bottom:16px;color:#1e3a5f}
.fr{display:flex;flex-direction:column;gap:4px;margin-bottom:12px}
.fr label{font-size:11px;color:#718096;font-weight:600}
.fr input,.fr select,.fr textarea{padding:7px 10px;border:1px solid #cbd5e0;border-radius:6px;font-size:12px;font-family:'맑은 고딕',sans-serif;background:#f8fafc}
.fr input:focus,.fr select:focus,.fr textarea:focus{outline:none;border-color:#3b82f6;background:#fff}
.fr textarea{height:110px;resize:vertical;line-height:1.6}
.fg{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.mf{display:flex;justify-content:flex-end;gap:8px;margin-top:8px}
.bc{padding:7px 16px;background:#f0f4f8;border:1px solid #cbd5e0;border-radius:6px;cursor:pointer;font-size:12px;font-family:'맑은 고딕',sans-serif}
.bs{padding:7px 16px;background:#3b82f6;color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:12px;font-family:'맑은 고딕',sans-serif;font-weight:600}
.bc:hover{background:#e2e8f0}.bs:hover{background:#2563eb}
.ctx{display:none;position:fixed;background:#fff;border:1px solid #e2e8f0;border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.15);z-index:200;min-width:140px;overflow:hidden}
.ctx.open{display:block}
.ci{padding:9px 16px;cursor:pointer;font-size:12px;color:#2d3748}
.ci:hover{background:#ebf8ff;color:#2b6cb0}
.ci.del:hover{background:#fff5f5;color:#e53e3e}
.sep{height:1px;background:#e2e8f0;margin:2px 0}
mark{background:#fef08a;border-radius:2px}
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:#f0f4f8}
::-webkit-scrollbar-thumb{background:#cbd5e0;border-radius:3px}
</style>
</head>
<body>
<div class="topbar">
  <h1>📋 인수인계 관리 [JC01]</h1><span style="font-size:10px;color:#64b5f6;background:rgba(255,255,255,0.1);padding:2px 8px;border-radius:4px;font-weight:400;letter-spacing:0.5px">v1.4.54</span>
  <span class="badge" id="tbadge">0건</span>
  <span id="netbadge" onclick="showNetInfo()" style="font-size:11px;padding:2px 8px;border-radius:99px;cursor:pointer;color:#f87171" title="확인 중...">●</span>
  <div class="spacer"></div>
  <button class="btn btn-new" onclick="openModal()">＋ 새 항목</button>
  <button class="btn btn-csv" onclick="exportCSV()">⬆ CSV 내보내기</button>
</div>
<div class="main">
  <div class="left">
    <div class="searchbar">
      <div class="sw"><input type="text" id="q" placeholder="내용, 설비, 근무자 검색..." oninput="applyFilter()"></div>
      <select id="fD" onchange="dongChanged()" style="font-weight:600;color:#2d4a7a">
        <option value="">전체 동</option>
        <option value="JC01" selected>JC01</option>
        <option value="JC02">JC02</option>
      </select>
      <div class="ms-wrap" id="equip-ms-wrap">
        <button type="button" class="ms-trigger" id="equip-ms-trigger" onclick="toggleEquipMS()">설비 ▾</button>
        <div class="ms-panel" id="equip-ms-panel"></div>
      </div>
      <select id="fC" onchange="applyFilter()">
        <option value="">구분</option>
        <option>설비이슈</option><option>전달사항</option>
        <option>기자재관리</option><option>Classification</option>
        <option>감소활동</option>
      </select>
      <button class="btn btn-parts" onclick="openPartsFile()">📋 파트 요청 리스트</button>
    </div>
    <div class="cntbar" id="cntbar"></div>
    <div class="tw">
      <div class="fhead">
        <div class="fc fc-flag"></div><div class="fc fc-dong">동</div><div class="fc fc-d">날짜</div><div class="fc fc-e">설비</div>
        <div class="fc fc-w">근무자</div><div class="fc fc-c">구분</div><div class="fc fc-ct th-l">내용</div>
      </div>
      <div id="tb"></div>
    </div>
  </div>
  <div class="pm-col">
    <div class="pm-hdr">🔧 설비 PM 체크리스트<span class="pm-saved" id="pm-saved"></span></div>
    <div class="pm-grid" id="pm-grid"></div>
  </div>
  <div class="right">
    <div class="card">
      <div class="cal-nav">
        <button onclick="chM(-1)">◀</button>
        <span id="ctitle"></span>
        <button onclick="chM(1)">▶</button>
      </div>
      <div class="dow"><span>일</span><span>월</span><span>화</span><span>수</span><span>목</span><span>금</span><span>토</span></div>
      <div class="days" id="days"></div>
      <div class="cal-range">
        <span>기간</span>
        <span class="rin"><input type="text" id="rs" placeholder="26/06/24" maxlength="8" inputmode="numeric" oninput="rangeType(this)" onchange="applyRange()"><input type="date" id="rsd" class="rpick" onchange="rangePick('rs',this.value)"></span>
        <span>~</span>
        <span class="rin"><input type="text" id="re" placeholder="26/06/24" maxlength="8" inputmode="numeric" oninput="rangeType(this)" onchange="applyRange()"><input type="date" id="red" class="rpick" onchange="rangePick('re',this.value)"></span>
        <button onclick="clearRange()">해제</button>
      </div>
    </div>
    <div class="memo-card">
      <div class="memo-hdr">📝 메모</div>
      <textarea id="memo-text" placeholder="자유롭게 메모하세요..." oninput="saveMemo()"></textarea>
      <div class="memo-footer" id="memo-saved"></div>
    </div>
  </div>
</div>

<div class="mbg" id="mbg" onclick="bgClick(event)">
  <div class="modal">
    <h2 id="mtitle">새 항목 추가</h2>
    <div class="fg">
      <div class="fr"><label>동</label>
        <select id="fdong">
          <option value="JC01">JC01</option>
          <option value="JC02">JC02</option>
        </select>
      </div>
      <div class="fr"><label>날짜</label><input type="date" id="fd"></div>
    </div>
    <div class="fg">
      <div class="fr"><label>설비</label><select id="fe"></select></div>
      <div class="fr"><label>근무자</label><input type="text" id="fw" placeholder="이름"></div>
    </div>
    <div class="fg">
      <div class="fr"><label>구분</label>
        <select id="fc">
          <option value="">선택</option>
          <option>설비이슈</option><option>전달사항</option>
          <option>기자재관리</option><option>Classification</option>
          <option>감소활동</option>
        </select>
      </div>
      <div class="fr"><label>근무조</label>
        <select id="fs">
          <option value="">선택</option>
          <option value="주">주</option>
          <option value="야">야</option>
        </select>
      </div>
    </div>
    <div class="fr"><label>내용</label>
      <textarea id="fct" placeholder="증상 → 조치 → 결과&#10;- 항목은 줄바꿈으로 구분"></textarea>
    </div>
    <div class="mf">
      <button class="bc" onclick="closeModal()">취소</button>
      <button class="bs" onclick="save()">저장</button>
    </div>
  </div>
</div>

<div class="ctx" id="ctx">
  <div class="ci" id="ciEdit" onclick="ctxEdit()">✏️ 수정</div>
  <div class="ci" onclick="ctxView()">🔍 내용 전체 보기</div>
  <div class="sep" id="ciSep"></div>
  <div class="ci del" id="ciDel" onclick="ctxDel()">🗑️ 삭제</div>
</div>

<script>
const EQUIP_BY_DONG={
  'JC01':['공통','#1','#2','#3','#4','#5','#21','#22','#31','#32','#41','#42','#51','#52','#99','ATW#61'],
  'JC02':['공통','#1','#2','#3','#4','#5','#6','#7','#31','#32','#41','#51','#52','#60','#61','#71','#96','#99'],
  '':['공통','#1','#2','#3','#4','#5','#6','#7','#10','#21','#22','#31','#32','#41','#42','#51','#52','#60','#61','#71','#96','#99','ATW#61']
};

// 목록 정렬용 근무조/구분/설비 우선순위. 날짜(역순) 다음 타이브레이커로 쓴다:
// 근무조(주>야>그 외) > 전달사항 > Classification > 기자재관리 > 설비이슈 > (그 외, 예: 감소활동).
const SHIFT_ORDER=['주','야'];
function shiftRank(s){ const i=SHIFT_ORDER.indexOf(s); return i===-1?SHIFT_ORDER.length:i; }
const CAT_ORDER=['전달사항','Classification','기자재관리','설비이슈'];
function catRank(c){ const i=CAT_ORDER.indexOf(c); return i===-1?CAT_ORDER.length:i; }
// 설비 호기 순서: EQUIP_BY_DONG의 나열 순서를 그대로 쓴다(공통→#1,#2..→ATW#61).
function equipRank(r){
  const list=EQUIP_BY_DONG[r.dong||'JC01']||EQUIP_BY_DONG[''];
  const i=list.indexOf(r.equip);
  return i===-1?list.length:i;
}

const EBG={'#1':'#c6f6d5','#2':'#c6f6d5','#3':'#c6f6d5','#4':'#c6f6d5','#5':'#c6f6d5',
'#21':'#fefcbf','#22':'#fefcbf','#31':'#bee3f8','#32':'#bee3f8',
'#41':'#fed7aa','#42':'#fed7aa','#51':'#e9d8fd','#52':'#e9d8fd',
'#61':'#b2f5ea','#99':'#fed7d7','ATW#61':'#b2f5ea','공통':'#e2e8f0'};
const EFG={'#1':'#276749','#2':'#276749','#3':'#276749','#4':'#276749','#5':'#276749',
'#21':'#744210','#22':'#744210','#31':'#2b6cb0','#32':'#2b6cb0',
'#41':'#7b341e','#42':'#7b341e','#51':'#553c9a','#52':'#553c9a',
'#61':'#234e52','#99':'#822727','ATW#61':'#234e52','공통':'#4a5568'};

const MY_DONG='JC01';   // 이 빌드가 쓰기 가능한 동 (Go의 myDong과 동일해야 함)
let all=[],fil=[],calY,calM,ctxId=null,editId=null;
let selDates=new Set(); // 달력에서 클릭해 선택한 날짜들 (여러 날 선택 가능, 비어있으면 전체)
let rangeStart='', rangeEnd=''; // 기간 필터(달력 밑 시작~종료 입력). 비어있으면 미적용

function today(){return new Date().toISOString().slice(0,10)}

function saveMemo(){
  const txt=document.getElementById('memo-text').value;
  memoSave('hk_memo',txt);
  const el=document.getElementById('memo-saved');
  el.textContent='저장됨 '+new Date().toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit'});
}

async function loadMemo(){
  const txt=(await memoLoad('hk_memo'))||'';
  document.getElementById('memo-text').value=txt;
  if(txt) document.getElementById('memo-saved').textContent='불러옴';
}

// ── 설비별 PM 체크리스트 (상시 표시 표) ───────────────────
// 메모와 똑같이 로컬 파일에 저장(껐다 켜도 유지). memoSave/memoLoad를 재활용하되
// 키를 'hk_pm_'+MY_DONG으로 해서 동별 파일이 갈린다(JC01=hk_pm_JC01.txt,
// JC02=hk_pm_JC02.txt). 값은 {설비명:내용} JSON 한 덩어리. 설비 목록은 이 동의
// 필터 설비(EQUIP_BY_DONG[MY_DONG])를 좌/우 두 개의 독립된 2칸(설비|내용) 그리드
// (.pm-half)로 나눠 배치한다. 두 반쪽이 서로 다른 그리드라, 한 설비 내용이 길어도
// 그 설비의 행만 커지고 옆(다른 반쪽) 설비 행 높이엔 영향이 없다(행 높이 커플링 제거).
let pmData={};
function pmCells(eq){
  if(!eq) return '';
  return '<div class="pm-cell pm-name">'+esc(eq)+'</div>'
    +'<div class="pm-cell pm-text" contenteditable="true" data-eq="'+esc(eq)+'" oninput="savePmCell(this)">'+esc(pmData[eq]||'')+'</div>';
}
function renderPmTable(){
  const list=EQUIP_BY_DONG[MY_DONG]||[];
  const half=Math.ceil(list.length/2);
  const hdr='<div class="pm-cell pm-h">설비</div><div class="pm-cell pm-h">내용</div>';
  let L=hdr, R=hdr;
  for(let r=0;r<half;r++) L+=pmCells(list[r]);
  for(let r=half;r<list.length;r++) R+=pmCells(list[r]);
  document.getElementById('pm-grid').innerHTML='<div class="pm-half">'+L+'</div><div class="pm-half">'+R+'</div>';
}
function savePmCell(el){
  const eq=el.getAttribute('data-eq');
  pmData[eq]=el.innerText;
  memoSave('hk_pm_'+MY_DONG, JSON.stringify(pmData));
  document.getElementById('pm-saved').textContent='저장됨 '+new Date().toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit'});
}
async function loadPmAll(){
  const raw=await memoLoad('hk_pm_'+MY_DONG);
  try{ pmData=raw?JSON.parse(raw):{}; }catch(e){ pmData={}; }
  renderPmTable();
}

// ── 설비 다중선택 상태 ──────────────────────────────────
let selectedEquips=new Set(); // 비어있으면 "전체"로 취급

function updateEquipFilter(){
  const dong=document.getElementById('fD').value;
  const list=EQUIP_BY_DONG[dong]||EQUIP_BY_DONG[''];
  // 동이 바뀌면 현재 동에 없는 설비 선택은 해제
  selectedEquips=new Set([...selectedEquips].filter(e=>list.includes(e)));
  renderEquipMS(list);
  updateEquipTriggerLabel();
}

function renderEquipMS(list){
  const panel=document.getElementById('equip-ms-panel');
  const itemsHtml=list.map(e=>{
    const checked=selectedEquips.has(e)?'checked':'';
    const safeId='eqcb-'+e.replace(/[^a-zA-Z0-9]/g,'_');
    return '<label class="ms-item" for="'+safeId+'">'
      +'<input type="checkbox" id="'+safeId+'" value="'+esc(e)+'" '+checked+' onchange="toggleEquipItem(\''+e.replace(/'/g,"\\'")+'\',this.checked)">'
      +'<span>'+esc(e)+'</span></label>';
  }).join('');
  panel.innerHTML=itemsHtml
    +'<div class="ms-footer">'
    +'<button onclick="equipSelectAll()">전체 선택</button>'
    +'<button onclick="equipSelectClear()">선택 해제</button>'
    +'</div>';
}

function toggleEquipItem(e,checked){
  if(checked) selectedEquips.add(e); else selectedEquips.delete(e);
  updateEquipTriggerLabel();
  applyFilter();
}

function equipSelectAll(){
  const dong=document.getElementById('fD').value;
  const list=EQUIP_BY_DONG[dong]||EQUIP_BY_DONG[''];
  selectedEquips=new Set(list);
  renderEquipMS(list);
  updateEquipTriggerLabel();
  applyFilter();
}

function equipSelectClear(){
  selectedEquips=new Set();
  const dong=document.getElementById('fD').value;
  const list=EQUIP_BY_DONG[dong]||EQUIP_BY_DONG[''];
  renderEquipMS(list);
  updateEquipTriggerLabel();
  applyFilter();
}

function updateEquipTriggerLabel(){
  const trigger=document.getElementById('equip-ms-trigger');
  const n=selectedEquips.size;
  if(n===0){
    trigger.textContent='설비 ▾';
    trigger.classList.remove('active');
  }else if(n===1){
    trigger.textContent=[...selectedEquips][0]+' ▾';
    trigger.classList.add('active');
  }else{
    trigger.textContent='설비 '+n+'개 ▾';
    trigger.classList.add('active');
  }
}

function toggleEquipMS(){
  document.getElementById('equip-ms-panel').classList.toggle('open');
}
document.addEventListener('click',function(e){
  const wrap=document.getElementById('equip-ms-wrap');
  if(wrap && !wrap.contains(e.target)){
    document.getElementById('equip-ms-panel').classList.remove('open');
  }
});

function updateEquipModal(){
  const dong=document.getElementById('fdong').value;
  const sel=document.getElementById('fe');
  const prev=sel.value;
  const list=EQUIP_BY_DONG[dong]||EQUIP_BY_DONG[''];
  sel.innerHTML=list.map(e=>'<option'+(e===prev?' selected':'')+'>'+e+'</option>').join('');
}

function dongChanged(){
  updateEquipFilter();
  applyFilter();
}

function fmtDate(ds){
  if(!ds||ds.length<10) return ds;
  const y=ds.slice(2,4), m=parseInt(ds.slice(5,7)), d=parseInt(ds.slice(8,10));
  return y+'.'+m+'.'+d;
}

async function init(){
  let netInfo=null;
  try{
    const raw=await dbGetAll();
    const parsed=JSON.parse(raw);
    all=parsed.records||[];
    netInfo=parsed;
  }catch(e){
    all=[];
  }
  // 배지 색을 먼저 적용하고 한 프레임 양보해서 화면에 그려지도록 한다.
  // (1384건 테이블 렌더링처럼 무거운 작업이 곧바로 이어지면
  //  배지 색 변경이 화면에 반영되기 전에 묻혀버릴 수 있다.)
  applyNetInfo(netInfo);
  await new Promise(r=>requestAnimationFrame(r));

  const t=new Date(); calY=t.getFullYear(); calM=t.getMonth()+1;
  document.getElementById('fD').value='JC01';
  updateEquipFilter();
  document.getElementById('fdong').addEventListener('change', updateEquipModal);
  updateEquipModal();
  // 스크롤이 하단 근처에 오면 다음 묶음을 렌더 (가상 스크롤)
  const tw=document.querySelector('.tw');
  if(tw) tw.addEventListener('scroll',()=>{
    if(shown<fil.length && tw.scrollTop+tw.clientHeight>=tw.scrollHeight-300) renderMore();
  });
  applyFilter(); renderCal(); loadMemo(); loadPmAll();
  scheduleMidnight();
}

function applyNetInfo(info){
  const nb=document.getElementById('netbadge');
  if(!info){
    nb.style.color='#f87171';
    nb.title='상태 확인 실패: 데이터 응답 없음';
    lastNetInfo={status:'확인 실패', network:'-', error:'dbGetAll 응답 파싱 실패'};
    return;
  }
  lastNetInfo=info;
  const online=info.status && info.status.indexOf('연결됨')>=0;
  nb.style.color=online?'#4ade80':'#f87171';
  let tip=info.status+'\n경로: '+info.network;
  if(info.error) tip+='\n\n원인: '+info.error;
  nb.title=tip;
}

let lastNetInfo=null;

// 배지를 클릭하면 dbGetAll을 다시 호출해서 최신 네트워크 상태와
// 데이터를 함께 갱신한다 (별도의 상태 전용 호출은 사용하지 않음).
async function showNetInfo(){
  const nb=document.getElementById('netbadge');
  nb.style.opacity='0.5';
  try{
    const raw=await dbGetAll();
    const parsed=JSON.parse(raw);
    all=parsed.records||[];
    applyNetInfo(parsed);
    applyFilter();
  }catch(e){
    applyNetInfo(null);
  }
  nb.style.opacity='1';
  // alert()는 화면 갱신을 멈추므로, 팝업 뜨기 전에 배지 색이
  // 먼저 화면에 그려지도록 한 프레임 양보한다.
  await new Promise(r=>requestAnimationFrame(r));
  if(!lastNetInfo){alert('상태 정보를 가져오지 못했습니다.');return;}
  let msg=lastNetInfo.status+'\n\n경로: '+lastNetInfo.network;
  if(lastNetInfo.error) msg+='\n\n원인: '+lastNetInfo.error;
  alert(msg);
}

function applyFilter(){
  const q=document.getElementById('q').value.trim().toLowerCase();
  const cat=document.getElementById('fC').value;
  const dong=document.getElementById('fD').value;
  fil=all.filter(r=>{
    if(rangeStart && r.date<rangeStart)return false;            // 기간 필터 시작(YYYY-MM-DD 문자열 비교)
    if(rangeEnd && r.date>rangeEnd)return false;                // 기간 필터 종료
    if(selDates.size>0 && !selDates.has(r.date))return false;   // 달력에서 선택한 날짜(들) 필터
    if(selectedEquips.size>0 && !selectedEquips.has(r.equip))return false;
    if(cat&&r.category!==cat)return false;
    if(dong&&(r.dong||'JC01')!==dong)return false;
    if(q&&!(r.content+r.equip+r.worker+r.category+r.date+(r.dong||'')).toLowerCase().includes(q))return false;
    return true;
  });
  // 정렬: 플래그(최상단) → 날짜 역순 → 근무조(야>주) → 구분 우선순위 → 설비 호기 순서 → id 역순(안정성).
  fil.sort((a,b)=>{
    if((b.flag?1:0)!==(a.flag?1:0)) return (b.flag?1:0)-(a.flag?1:0);
    if(b.date!==a.date) return b.date.localeCompare(a.date);
    const sa=shiftRank(a.shift), sb=shiftRank(b.shift);
    if(sa!==sb) return sa-sb;
    const ca=catRank(a.category), cb=catRank(b.category);
    if(ca!==cb) return ca-cb;
    const ea=equipRank(a), eb=equipRank(b);
    if(ea!==eb) return ea-eb;
    return b.id-a.id;
  });
  renderTable(); updateBadge(); renderCal();
}

function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}
function hl(s,q){
  if(!q)return esc(s);
  const re=new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),'gi');
  return esc(s).replace(re,m=>'<mark>'+m+'</mark>');
}

// 가상 스크롤(점진적 렌더): 필터 결과(fil)를 한 번에 다 그리면 1만 건에서
// 수만 개 DOM 노드가 생겨 렉이 걸린다. RCHUNK개씩만 이어붙이고, 스크롤이
// 하단에 가까워지면 다음 묶음을 렌더한다. 초기 렌더는 수십 건뿐이라 즉시 뜬다.
const RCHUNK=60;
let shown=0, curQ='';
// 근무자 셀: 쉼표로 구분된 여러 근무자는 줄바꿈(<br>)으로 여러 줄로 보이게 하고,
// 가장 긴 이름 글자수에 맞춰 폰트를 줄여 88px 칸에 넘치지 않게 한다. shift(주/야)가
// 있으면 이름 위에 한 줄 더 붙인다.
function workerCell(w,shift){
  const parts=String(w||'').split(',').map(s=>s.trim()).filter(Boolean);
  const maxLen=parts.reduce((m,p)=>Math.max(m,[...p].length),0);
  let fs=12;
  if(maxLen>=9) fs=8; else if(maxLen>=7) fs=9; else if(maxLen>=6) fs=10; else if(maxLen>=5) fs=11;
  const shiftHtml=shift?'<div class="wk-shift">'+esc(shift)+'</div>':'';
  return '<div class="fc fc-w"><div class="wk" style="font-size:'+fs+'px">'+shiftHtml+parts.map(esc).join('<br>')+'</div></div>';
}
function rowHTML(r){
  const bg=EBG[r.equip]||'#e2e8f0', fg=EFG[r.equip]||'#4a5568';
  const pv=r.content;
  const mine=(r.dong||'JC01')===MY_DONG;
  // 상대 동 레코드는 읽기 전용: 플래그 버튼을 흐리게 비활성화하고(서버도
  // dbSetFlag에서 거부), 우클릭 메뉴의 수정/삭제도 rowCtx에서 숨긴다.
  const flagBtn = mine
    ? '<button class="flagbtn'+(r.flag?' on':'')+'" onclick="toggleFlag(event,'+r.id+')" title="최상단 고정">⚑</button>'
    : '<span class="flagbtn dim" title="다른 동 항목은 변경할 수 없습니다">⚑</span>';
  // 근무조(주/야)에 따라 행 전체 배경색을 옅게 칠해 한눈에 구분되게 한다.
  const shiftCls = r.shift==='주'?' shift-day':(r.shift==='야'?' shift-night':'');
  return '<div class="frow'+(r.flag?' flagged':'')+(mine?'':' foreign')+shiftCls+'" id="R'+r.id+'" onclick="rowClick('+r.id+')" oncontextmenu="rowCtx(event,'+r.id+')">'
    +'<div class="fc fc-flag">'+flagBtn+'</div>'
    +'<div class="fc fc-dong"><span class="dong-badge">'+(r.dong||'JC01')+'</span></div>'
    +'<div class="fc fc-d">'+fmtDate(r.date)+'</div>'
    +'<div class="fc fc-e"><span class="eb" style="background:'+bg+';color:'+fg+'">'+esc(r.equip)+'</span></div>'
    +workerCell(r.worker,r.shift)
    +'<div class="fc fc-c"><span class="chip c'+r.category.replace(/\s/g,'')+'">'+esc(r.category)+'</span></div>'
    +'<div class="fc fc-ct"><div class="pv">'+hl(pv,curQ)+'</div></div>'
    +'</div>';
}
function renderMore(){
  const tb=document.getElementById('tb');
  const end=Math.min(shown+RCHUNK, fil.length);
  let html='';
  for(let i=shown;i<end;i++) html+=rowHTML(fil[i]);
  if(html) tb.insertAdjacentHTML('beforeend', html);
  shown=end;
}
function renderTable(){
  curQ=document.getElementById('q').value.trim().toLowerCase();
  const tb=document.getElementById('tb');
  const tw=document.querySelector('.tw');
  shown=0; tb.innerHTML='';
  if(!fil.length){
    tb.innerHTML='<div style="text-align:center;padding:40px;color:#a0aec0">검색 결과가 없습니다</div>';
    return;
  }
  if(tw) tw.scrollTop=0;
  renderMore();
  // 뷰포트가 안 차면 스크롤바가 안 생겨 추가 로드가 트리거되지 않으므로,
  // 화면이 찰 때까지(또는 다 그릴 때까지) 미리 채운다.
  let guard=0;
  while(tw && shown<fil.length && tw.scrollHeight<=tw.clientHeight && guard++<100) renderMore();
}

async function toggleFlag(e,id){
  e.stopPropagation();
  const r=all.find(x=>x.id===id);
  if(!r||(r.dong||'JC01')!==MY_DONG) return;
  r.flag=!r.flag;          // 낙관적 갱신: 즉시 최상단으로
  applyFilter();
  const ok=await dbSetFlag(id,r.flag);
  if(!ok){ r.flag=!r.flag; applyFilter(); }
}

function rowClick(id){
  // 행 클릭은 선택 표시(하이라이트)만 한다. (예전엔 달력 밑 상세 패널을
  // 띄웠으나, 상세 패널을 없애고 날짜 필터는 달력에서만 거는 방식으로 바뀜)
  document.querySelectorAll('.frow').forEach(t=>t.classList.remove('sel'));
  const row=document.getElementById('R'+id);
  if(row)row.classList.add('sel');
}

function rowCtx(e,id){
  e.preventDefault(); ctxId=id;
  const r=all.find(x=>x.id===id);
  const mine=r&&(r.dong||'JC01')===MY_DONG;
  // 상대 동 항목은 우클릭 메뉴에서 수정/삭제를 숨긴다 (읽기 전용).
  document.getElementById('ciEdit').style.display=mine?'':'none';
  document.getElementById('ciDel').style.display=mine?'':'none';
  document.getElementById('ciSep').style.display=mine?'':'none';
  const c=document.getElementById('ctx');
  c.style.left=e.clientX+'px'; c.style.top=e.clientY+'px'; c.classList.add('open');
  rowClick(id);
}
function closeCtx(){document.getElementById('ctx').classList.remove('open')}
document.addEventListener('click',closeCtx);
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeCtx();closeModal();}});

function ctxEdit(){closeCtx();if(ctxId!==null){const r=all.find(r=>r.id===ctxId);if(r&&(r.dong||'JC01')===MY_DONG)openModal(r);}}
function ctxView(){closeCtx();if(ctxId!==null){const r=all.find(r=>r.id===ctxId);if(r)viewFull(r);}}
async function ctxDel(){
  closeCtx();
  if(ctxId===null)return;
  if(!confirm('선택한 항목을 삭제하시겠습니까?'))return;
  const ok=await dbDelete(ctxId);
  if(!ok){alert('다른 동의 항목은 삭제할 수 없습니다.');return;}
  all=all.filter(r=>r.id!==ctxId);
  applyFilter();
}

function updateBadge(){
  const t=all.length,s=fil.length;
  document.getElementById('tbadge').textContent=t+'건';
  const txt=s<t?s+'건 표시 중 (전체 '+t+'건)':'전체 '+t+'건';
  const cb=document.getElementById('cntbar');
  let chips='';
  if(rangeStart||rangeEnd){
    // 기간 필터가 켜져 있으면 초록 칩으로 표시하고 ✕로 해제할 수 있게 한다.
    const label=(rangeStart?rangeFmt(rangeStart):'…')+' ~ '+(rangeEnd?rangeFmt(rangeEnd):'…');
    chips+='<span style="background:#38a169;color:#fff;padding:2px 8px;border-radius:99px;font-weight:600;margin-right:6px">📆 '
      +label+' <span onclick="clearRange()" style="cursor:pointer;margin-left:2px">✕</span></span>';
  }
  if(selDates.size>0){
    // 날짜 필터가 켜져 있으면 파란 칩으로 표시하고 ✕로 해제할 수 있게 한다.
    // 선택한 날짜가 3개 이하면 다 나열하고, 많으면 개수만 보여준다.
    const sorted=[...selDates].sort();
    const label=sorted.length<=3?sorted.join(', '):sorted.length+'일 선택';
    chips+='<span style="background:#3b82f6;color:#fff;padding:2px 8px;border-radius:99px;font-weight:600;margin-right:6px" title="'+sorted.join(', ')+'">📅 '
      +label+' <span onclick="clearDateFilter()" style="cursor:pointer;margin-left:2px">✕</span></span>';
  }
  if(chips){cb.innerHTML=chips+txt;}else{cb.textContent=txt;}
}
function clearDateFilter(){selDates.clear();applyFilter();}
// 기간 필터: 달력 밑 시작(#rs)~종료(#re) 입력. 화면 표시는 YY/MM/DD(예:26/06/24)지만
// 내부 상태(rangeStart/End)는 비교용으로 YYYY-MM-DD로 저장한다. 시작만/종료만 넣어도
// 각각 이후/이전으로 동작. 시작>종료면 자동으로 뒤바꿔 처리.
function rangeParse(v){ // '26/06/24' → '2026-06-24' (불완전/비정상 입력은 '')
  const m=String(v).trim().match(/^(\d{2})\D?(\d{1,2})\D?(\d{1,2})$/);
  if(!m) return '';
  const mm=+m[2], dd=+m[3];
  if(mm<1||mm>12||dd<1||dd>31) return '';
  return '20'+m[1]+'-'+String(mm).padStart(2,'0')+'-'+String(dd).padStart(2,'0');
}
function rangeFmt(iso){ return iso? iso.slice(2,4)+'/'+iso.slice(5,7)+'/'+iso.slice(8,10):''; }
function rangeType(el){ // 숫자만 받아 2,4자리 뒤에 / 자동 삽입 → 26/06/24
  let v=el.value.replace(/[^0-9]/g,'').slice(0,6);
  if(v.length>=5) v=v.slice(0,2)+'/'+v.slice(2,4)+'/'+v.slice(4);
  else if(v.length>=3) v=v.slice(0,2)+'/'+v.slice(2);
  el.value=v;
}
// 달력 아이콘(#rsd/#red, 네이티브 date)으로 고른 날짜(YYYY-MM-DD)를 텍스트칸(26/06/24)에
// 반영. 텍스트 타이핑과 달력 클릭 둘 다로 기간을 설정할 수 있다.
function rangePick(target, iso){
  document.getElementById(target).value = iso ? rangeFmt(iso) : '';
  applyRange();
}
function applyRange(){
  let a=rangeParse(document.getElementById('rs').value), b=rangeParse(document.getElementById('re').value);
  if(a&&b&&a>b){const t=a;a=b;b=t;}
  rangeStart=a; rangeEnd=b;
  if(a) document.getElementById('rs').value=rangeFmt(a);
  if(b) document.getElementById('re').value=rangeFmt(b);
  document.getElementById('rsd').value=a||''; document.getElementById('red').value=b||''; // 달력 팝업이 고른 날짜에서 열리게 동기화
  applyFilter();
}
function clearRange(){
  rangeStart=''; rangeEnd='';
  document.getElementById('rs').value=''; document.getElementById('re').value='';
  document.getElementById('rsd').value=''; document.getElementById('red').value='';
  applyFilter();
}

function renderCal(){
  document.getElementById('ctitle').textContent=calY+'년 '+calM+'월';
  const cd=document.getElementById('fD').value;
  const ds=new Set(all.filter(r=>!cd||(r.dong||'JC01')===cd).map(r=>r.date)), td=today();
  const fd=new Date(calY,calM-1,1).getDay(), dm=new Date(calY,calM,0).getDate();
  let h='';
  for(let i=0;i<fd;i++)h+='<div class="day em"></div>';
  for(let d=1;d<=dm;d++){
    const s=calY+'-'+String(calM).padStart(2,'0')+'-'+String(d).padStart(2,'0');
    const dow=new Date(calY,calM-1,d).getDay();
    const wd=dow===0?'sun':(dow===6?'sat':'');
    const inRng=(rangeStart||rangeEnd)&&(!rangeStart||s>=rangeStart)&&(!rangeEnd||s<=rangeEnd);
    const cls=['day',wd,inRng?'rng':'',s===td?'td2':'',ds.has(s)?'hd':'',selDates.has(s)?'sd':''].filter(Boolean).join(' ');
    h+='<div class="'+cls+'" onclick="selDate2(\''+s+'\')">'+d+'</div>';
  }
  document.getElementById('days').innerHTML=h;
}

function chM(d){calM+=d;if(calM<1){calM=12;calY--;}if(calM>12){calM=1;calY++;}renderCal();}
// 앱을 켜둔 채 날짜가 바뀌면 달력의 '오늘'(.td2) 표시가 어제에 멈춘다. 다음 날
// 00:00:02에 renderCal을 다시 불러 오늘 표시를 갱신하고, 그 뒤 매일 자정마다
// 반복하도록 재예약한다(자정에서 1~2초 여유를 둬 new Date()가 확실히 새 날로 넘어간 뒤 실행).
function scheduleMidnight(){
  const now=new Date();
  const next=new Date(now.getFullYear(),now.getMonth(),now.getDate()+1,0,0,2);
  setTimeout(function(){ renderCal(); scheduleMidnight(); }, next-now);
}
// 달력 날짜 클릭 = 메인 목록을 그 날짜(들)만 표시하는 필터. 여러 날짜를 클릭해
// 누적 선택할 수 있고, 이미 선택된 날짜를 다시 클릭하면 그 날짜만 해제(토글).
// applyFilter가 renderTable/updateBadge/renderCal을 모두 다시 그리므로
// 여기서 renderCal을 따로 부르지 않는다.
function selDate2(ds){
  if(selDates.has(ds)) selDates.delete(ds); else selDates.add(ds);
  applyFilter();
}

function openModal(rec){
  editId=rec?rec.id:null;
  document.getElementById('mtitle').textContent=rec?'항목 수정':'새 항목 추가';

  // 새 항목은 항상 내 동(MY_DONG)으로만 생성 가능. 근무자/구분 기본값도
  // 내 동에서 가장 최근(최대 id) 레코드를 따라간다.
  let lastRecord=null;
  if(!rec && all.length){
    const dongRecords = all.filter(r=>(r.dong||'JC01')===MY_DONG);
    if(dongRecords.length) lastRecord = dongRecords.reduce((a,b)=> (b.id>a.id?b:a), dongRecords[0]);
  }

  // 동 선택은 내 동으로 고정하고 잠근다 (다른 동 레코드 생성 방지).
  const fdong=document.getElementById('fdong');
  fdong.value = MY_DONG;
  fdong.disabled = true;
  updateEquipModal();
  document.getElementById('fd').value=rec?rec.date:today();
  document.getElementById('fe').value=rec?rec.equip:'';
  document.getElementById('fw').value = rec ? rec.worker : (lastRecord ? lastRecord.worker : '');
  document.getElementById('fs').value = rec ? (rec.shift||'') : '';
  document.getElementById('fc').value = rec ? rec.category : (lastRecord ? lastRecord.category : '');
  document.getElementById('fct').value=rec?rec.content:'';
  document.getElementById('mbg').classList.add('open');
  setTimeout(()=>document.getElementById('fd').focus(),100);
}
function closeModal(){document.getElementById('mbg').classList.remove('open');editId=null;}
function bgClick(e){if(e.target===document.getElementById('mbg'))closeModal();}

async function save(){
  const dong=document.getElementById('fdong').value.trim();
  const date=document.getElementById('fd').value.trim();
  const equip=document.getElementById('fe').value.trim();
  const worker=document.getElementById('fw').value.trim();
  const shift=document.getElementById('fs').value.trim();
  const cat=document.getElementById('fc').value.trim();
  const content=document.getElementById('fct').value.trim();
  if(!date||!equip||!cat||!content){alert('필수 항목을 입력해주세요.');return;}
  if(editId!==null){
    await dbUpdate(editId,date,equip,worker,shift,cat,content,dong);
    const i=all.findIndex(r=>r.id===editId);
    if(i>=0)all[i]={...all[i],id:editId,date,equip,worker,shift,category:cat,content,dong};
  }else{
    const raw=await dbAdd(date,equip,worker,shift,cat,content,dong);
    all.push(JSON.parse(raw));
  }
  closeModal();
  // 새 항목을 추가해도 사용자가 걸어둔 날짜 필터(selDates)는 유지한다(예전엔
  // 여기서 selDates.clear()로 필터를 풀었으나, 사용자가 필터가 풀린다고 불편을
  // 호소해 제거함). 달력만 저장한 항목의 달로 이동시킨다(해당 날짜에 점이 보이게).
  const y=parseInt(date.slice(0,4)),m=parseInt(date.slice(5,7));
  calY=y;calM=m;
  applyFilter();
}

function viewFull(r){
  const bg=EBG[r.equip]||'#e2e8f0',fg=EFG[r.equip]||'#4a5568';
  const d=document.createElement('div');
  d.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:300;display:flex;align-items:center;justify-content:center';
  d.innerHTML='<div style="background:#fff;border-radius:12px;padding:20px;width:600px;max-width:95vw;max-height:80vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.3)">'
    +'<div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid #e2e8f0">'
    +'<span class="chip c'+r.category.replace(/\s/g,'')+'">'+esc(r.category)+'</span>'
    +'<span class="eb" style="background:'+bg+';color:'+fg+'">'+esc(r.equip)+'</span>'
    +'<span style="color:#718096;font-size:11px">'+esc(r.worker)+'</span>'
    +'<span style="color:#718096;font-size:11px;margin-left:auto">'+esc(r.date)+'</span>'
    +'<button class="vfclose" style="margin-left:8px;background:none;border:none;cursor:pointer;font-size:18px;color:#718096;line-height:1">✕</button>'
    +'</div>'
    +'<div style="overflow-y:auto;white-space:pre-wrap;font-size:13px;line-height:1.8;color:#2d3748;flex:1">'+esc(r.content)+'</div>'
    +'</div>';
  d.querySelector('.vfclose').onclick=()=>d.remove();
  d.onclick=e=>{if(e.target===d)d.remove();};
  document.body.appendChild(d);
}

function exportCSV(){
  const rows=[['동','날짜','설비','근무자','구분','내용']];
  [...all].sort((a,b)=> b.date!==a.date ? b.date.localeCompare(a.date) : b.id-a.id)
    .forEach(r=>rows.push([r.dong||'JC01',r.date,r.equip,r.worker,r.category,r.content]));
  const csv=rows.map(row=>row.map(c=>'"'+String(c).replace(/"/g,'""')+'"').join(',')).join('\r\n');
  const blob=new Blob(['\uFEFF'+csv],{type:'text/csv;charset=utf-8'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  a.href=url; a.download='인수인계_'+today()+'.csv'; a.click();
  URL.revokeObjectURL(url);
}

async function openPartsFile(){
  const res=await openPartsFile_go();
  if(res.startsWith('ERR:')){
    alert('파일을 열 수 없습니다: '+res.slice(4));
  }
}

init();
</script>
</body>
</html>`, "")
}

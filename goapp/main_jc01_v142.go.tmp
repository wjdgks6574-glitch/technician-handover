//go:embed initial_data_v142.json
var initialDataJSON []byte

type Record struct {
	ID       int    `json:"id"`
	Date     string `json:"date"`
	Equip    string `json:"equip"`
	Worker   string `json:"worker"`
	Category string `json:"category"`
	Content  string `json:"content"`
	Dong     string `json:"dong"`
}

var dataFile string    // 네트워크 주 저장소 경로
var cacheFile string   // 로컬 안전망 (네트워크 접근 실패 시에만 사용)
var records []Record
var w webview.WebView
var networkOK bool
var lastNetErr string

func getDataDir() string {
	appData := os.Getenv("APPDATA")
	if appData == "" {
		home, _ := os.UserHomeDir()
		appData = home
	}
	dir := filepath.Join(appData, "인수인계관리")
	os.MkdirAll(dir, 0755)
	return dir
}

func getNetworkDir() string {
	return `\\172.23.11.175\ETC_JC_BergerHalm\인수인계관리_DB`
}

// readWithTimeout은 파일 읽기가 오래 걸릴 때(예: 네트워크 서버 다운으로
// 인한 SMB 타임아웃) 프로그램이 멈추지 않도록 지정된 시간(초) 안에
// 끝나지 않으면 포기하고 nil을 반환한다.
func readWithTimeout(path string, seconds int) []Record {
	type result struct{ rs []Record }
	ch := make(chan result, 1)
	go func() {
		data, err := os.ReadFile(path)
		if err != nil {
			lastNetErr = "읽기 실패: " + err.Error()
			ch <- result{nil}
			return
		}
		var rs []Record
		if err := json.Unmarshal(data, &rs); err != nil {
			lastNetErr = "데이터 형식 오류: " + err.Error()
			ch <- result{nil}
			return
		}
		lastNetErr = ""
		ch <- result{rs}
	}()
	select {
	case r := <-ch:
		return r.rs
	case <-time.After(time.Duration(seconds) * time.Second):
		lastNetErr = fmt.Sprintf("응답 없음 (%d초 초과) - 서버가 꺼져있거나 경로에 접근할 수 없습니다", seconds)
		return nil
	}
}

// writeWithTimeout은 네트워크 쓰기가 오래 걸릴 때 프로그램이 멈추지
// 않도록 지정된 시간(초) 안에 끝나지 않으면 실패로 처리한다.
func writeWithTimeout(path string, rs []Record, seconds int) bool {
	ch := make(chan bool, 1)
	go func() {
		data, err := json.MarshalIndent(rs, "", "  ")
		if err != nil {
			lastNetErr = "직렬화 오류: " + err.Error()
			ch <- false
			return
		}
		dir := filepath.Dir(path)
		if err := os.MkdirAll(dir, 0755); err != nil {
			lastNetErr = "폴더 생성 실패: " + err.Error()
			ch <- false
			return
		}
		tmp := path + ".tmp"
		if err := os.WriteFile(tmp, data, 0644); err != nil {
			lastNetErr = "파일 쓰기 실패: " + err.Error()
			ch <- false
			return
		}
		if err := os.Rename(tmp, path); err != nil {
			lastNetErr = "파일 이름변경 실패: " + err.Error()
			ch <- false
			return
		}
		lastNetErr = ""
		ch <- true
	}()
	select {
	case ok := <-ch:
		return ok
	case <-time.After(time.Duration(seconds) * time.Second):
		lastNetErr = fmt.Sprintf("응답 없음 (%d초 초과) - 서버가 꺼져있거나 경로에 접근할 수 없습니다", seconds)
		return false
	}
}

// migrateEquipNames는 예전에 "ATW#XX"로 저장되던 설비명을
// "#XX"로 통일한다 (ATW#61은 예외로 그대로 유지).
// 기존에 저장된 네트워크/로컬 파일의 데이터도 이 규칙으로 정리한다.
var equipRenameMap = map[string]string{
	"ATW#21": "#21",
	"ATW#22": "#22",
	"ATW#31": "#31",
	"ATW#32": "#32",
	"ATW#41": "#41",
	"ATW#42": "#42",
	"ATW#51": "#51",
	"ATW#52": "#52",
}

func migrateEquipNames(rs []Record) ([]Record, bool) {
	changed := false
	for i := range rs {
		if newName, ok := equipRenameMap[rs[i].Equip]; ok {
			rs[i].Equip = newName
			changed = true
		}
	}
	return rs, changed
}

// migrateIDOffsets는 JC01/JC02가 같은 records.json을 공유하면서 오프라인 중
// 각자 로컬 백업 기준으로 ID를 새로 채번하다가 재접속 시 충돌하는 문제를
// 막기 위해, 동(dong)별로 ID 대역을 분리한다.
// JC01: 100000번대, JC02: 200000번대. 예전 방식(순차 정수 ID)으로 저장된
// 데이터를 만나면 여기서 한 번만 옮겨준다 (이미 대역 안에 있으면 그대로 둠).
func migrateIDOffsets(rs []Record) ([]Record, bool) {
	changed := false
	for i := range rs {
		switch rs[i].Dong {
		case "JC01":
			if rs[i].ID < 100000 {
				rs[i].ID += 100000
				changed = true
			}
		case "JC02":
			if rs[i].ID < 200000 {
				rs[i].ID += 200000
				changed = true
			}
		}
	}
	return rs, changed
}

func loadRecords() {
	dataFile = filepath.Join(getNetworkDir(), "records.json")
	cacheFile = filepath.Join(getDataDir(), "records_local_backup.json")

	// 1순위: 네트워크 파일 (5초 타임아웃)
	netRecords := readWithTimeout(dataFile, 5)
	if netRecords != nil {
		records = netRecords
		networkOK = true
		eqRecords, eqChanged := migrateEquipNames(records)
		idRecords, idChanged := migrateIDOffsets(eqRecords)
		records = idRecords
		if eqChanged || idChanged {
			saveRecords()
			return
		}
		// 로컬에 안전망 백업 (네트워크 다운 시 대비)
		writeWithTimeout(cacheFile, records, 3)
		return
	}
	networkOK = false

	// 2순위: 네트워크 접근 실패 시 → 로컬 백업본
	localRecords := readWithTimeout(cacheFile, 3)
	if localRecords != nil {
		records = localRecords
		eqRecords, eqChanged := migrateEquipNames(records)
		idRecords, idChanged := migrateIDOffsets(eqRecords)
		records = idRecords
		if eqChanged || idChanged {
			writeWithTimeout(cacheFile, records, 3)
		}
		return
	}

	// 3순위: 로컬 백업도 없으면 → 프로그램 내장 초기 데이터
	var initial []Record
	if jerr := json.Unmarshal(initialDataJSON, &initial); jerr == nil {
		records = initial
	} else {
		records = []Record{}
	}
}

func saveRecords() {
	ok := writeWithTimeout(dataFile, records, 5)
	networkOK = ok
	// 네트워크 저장 성공 여부와 관계없이 로컬 안전망은 항상 갱신
	writeWithTimeout(cacheFile, records, 3)
}

// JC01은 100000번대 ID를 쓴다 (JC02는 200000번대). 공유 파일을 오프라인
// 상태에서 각자 채번하다가 재접속했을 때 ID가 겹치지 않게 하기 위함.
func nextID() int {
	max := 100000
	for _, r := range records {
		if r.ID > max && r.ID < 200000 {
			max = r.ID
		}
	}
	return max + 1
}

func toJSON(v interface{}) string {
	b, _ := json.Marshal(v)
	return string(b)
}

func handleBind(w webview.WebView) {
	w.Bind("dbGetAll", func() string {
		status := "네트워크 저장소 연결됨"
		if !networkOK {
			status = "⚠ 네트워크 연결 안됨 - 로컬 백업본 사용 중"
		}
		return toJSON(map[string]interface{}{
			"records": records,
			"network": dataFile,
			"backup":  cacheFile,
			"status":  status,
			"error":   lastNetErr,
		})
	})

	w.Bind("dbAdd", func(date, equip, worker, category, content, dong string) string {
		r := Record{
			ID:       nextID(),
			Date:     strings.TrimSpace(date),
			Equip:    strings.TrimSpace(equip),
			Worker:   strings.TrimSpace(worker),
			Category: strings.TrimSpace(category),
			Content:  strings.TrimSpace(content),
			Dong:     strings.TrimSpace(dong),
		}
		records = append(records, r)
		saveRecords()
		return toJSON(r)
	})

	w.Bind("dbUpdate", func(id int, date, equip, worker, category, content, dong string) bool {
		for i := range records {
			if records[i].ID == id {
				records[i].Date = strings.TrimSpace(date)
				records[i].Equip = strings.TrimSpace(equip)
				records[i].Worker = strings.TrimSpace(worker)
				records[i].Category = strings.TrimSpace(category)
				records[i].Content = strings.TrimSpace(content)
				records[i].Dong = strings.TrimSpace(dong)
				saveRecords()
				return true
			}
		}
		return false
	})

	w.Bind("dbDelete", func(id int) bool {
		for i := range records {
			if records[i].ID == id {
				records = append(records[:i], records[i+1:]...)
				saveRecords()
				return true
			}
		}
		return false
	})

	w.Bind("dbGetPath", func() string {
		status := "네트워크 저장소 연결됨"
		if !networkOK {
			status = "⚠ 네트워크 연결 안됨 - 로컬 백업본 사용 중"
		}
		return toJSON(map[string]string{
			"network": dataFile,
			"backup":  cacheFile,
			"status":  status,
			"error":   lastNetErr,
		})
	})

	w.Bind("openPartsFile_go", func() string {
		return openPartsFileImpl()
	})
}

func openPartsFileImpl() string {
	dir := `\\172.23.11.175\ETC_JC_BergerHalm\1동\Pending Item&지속관리`
	entries, err := os.ReadDir(dir)
	if err != nil {
		return "ERR:폴더를 찾을 수 없습니다 (" + err.Error() + ")"
	}
	var target string
	for _, e := range entries {
		name := e.Name()
		if strings.HasPrefix(name, "~$") {
			continue
		}
		if strings.Contains(name, "JC_1 Sorter 필요 Parts") &&
			(strings.HasSuffix(name, ".xlsx") || strings.HasSuffix(name, ".xls") || strings.HasSuffix(name, ".xlsb")) {
			target = filepath.Join(dir, name)
			break
		}
	}
	if target == "" {
		return "ERR:파일을 찾을 수 없습니다"
	}
	cmd := exec.Command("cmd", "/C", "start", "", target)
	if err := cmd.Start(); err != nil {
		return "ERR:파일 열기 실패 (" + err.Error() + ")"
	}
	return "OK:" + target
}

const (
	SW_MAXIMIZE = 3
)

func maximizeWindow(hwnd unsafe.Pointer) {
	user32 := syscall.NewLazyDLL("user32.dll")
	showWindow := user32.NewProc("ShowWindow")
	showWindow.Call(uintptr(hwnd), uintptr(SW_MAXIMIZE))
}

func main() {
	loadRecords()

	w = webview.NewWithOptions(webview.WebViewOptions{
		Debug: false,
		WindowOptions: webview.WindowOptions{
			Title:  "인수인계 관리",
			Width:  1280,
			Height: 800,
			Center: true,
		},
	})
	if w == nil {
		log.Fatal("WebView2 초기화 실패. Windows 10/11이 필요합니다.")
	}
	defer w.Destroy()

	w.SetTitle("📋 인수인계 관리")

	go func() {
		time.Sleep(300 * time.Millisecond)
		maximizeWindow(w.Window())
	}()

	handleBind(w)
	w.SetHtml(buildHTML())
	w.Run()
}

var _ = unsafe.Pointer(nil)

